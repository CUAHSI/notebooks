    "# create an S3 access key and secret key for the authenticated user\n",
    "response = requests.post(f\"https://hydroshare.org/hsapi/user/service/accounts/s3/\", auth=(username, password))\n",
    "response_json = response.json()\n",
    "access_key = response_json['access_key']\n",
    "secret_key = response_json['secret_key']"
   ]
  },
  {
   "cell_type": "markdown",
   "id": "c16385b5-a3e3-4990-8d12-55f55b5068cb",
   "metadata": {},
   "source": [
    "Run the next cell to create a connection to the HydroShare S3 bucket using the `s3fs` library. `s3fs` provides a filesystem-like interface to S3, making it easy to list, read, and write files as if they were on your local machine. For more information, refer to the [s3fs documentation](https://s3fs.readthedocs.io/en/latest/)."
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "id": "1a50ba9d-0c01-41ab-8d5c-3b8ff453b1f5",
   "metadata": {},
   "outputs": [],
   "source": [
    "# create a filesystem-like client for S3\n",
    "s3 = s3fs.S3FileSystem(key=access_key,\n",
    "                       secret=secret_key,\n",
    "                       endpoint_url='https://s3.hydroshare.org')"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "id": "f934085e-1e8d-40f1-963b-a865576b96a3",
   "metadata": {},
   "outputs": [],
   "source": [
    "# get the s3_path for the resource_id\n",
    "response = requests.get(f\"https://hydroshare.org/hsapi/resource/s3/{resource_id}/\", auth=(username, password))\n",
    "response_json = response.json()\n",
    "s3_path = f\"{response_json['bucket']}/{response_json['prefix']}\"\n",
    "\n",
    "s3.ls(s3_path)"
   ]
  },
